{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:lang(zh|es|fr|de|pt|ja|ko|ar)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/zh/:path*",
      "destination": "/zh/:path*"
    },
    {
      "source": "/es/:path*",
      "destination": "/es/:path*"
    },
    {
      "source": "/fr/:path*",
      "destination": "/fr/:path*"
    },
    {
      "source": "/de/:path*",
      "destination": "/de/:path*"
    },
    {
      "source": "/pt/:path*",
      "destination": "/pt/:path*"
    },
    {
      "source": "/ja/:path*",
      "destination": "/ja/:path*"
    },
    {
      "source": "/ko/:path*",
      "destination": "/ko/:path*"
    },
    {
      "source": "/ar/:path*",
      "destination": "/ar/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/zh",
      "destination": "/zh/",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/de",
      "destination": "/de/",
      "permanent": true
    },
    {
      "source": "/pt",
      "destination": "/pt/",
      "permanent": true
    },
    {
      "source": "/ja",
      "destination": "/ja/",
      "permanent": true
    },
    {
      "source": "/ko",
      "destination": "/ko/",
      "permanent": true
    },
    {
      "source": "/ar",
      "destination": "/ar/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/products.html",
      "permanent": true
    },
    {
      "source": "/wholesale",
      "destination": "/wholesale.html",
      "permanent": true
    },
    {
      "source": "/craft",
      "destination": "/craft.html",
      "permanent": true
    },
    {
      "source": "/story",
      "destination": "/story.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "permanent": true
    }
  ]
}
